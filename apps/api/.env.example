NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/easygenerator-auth

# Generate each with: openssl rand -base64 48  (min 32 chars, must differ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Web origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Rate limits per client IP per minute. Raise them in tests.
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5

# Set true when running behind a reverse proxy (nginx) so rate limiting sees the real client IP
TRUST_PROXY=false
# Cookie Secure flag. Defaults to true when NODE_ENV=production, false otherwise.
# Set false only for a plain-http local run (Safari drops Secure cookies on http://localhost).
# COOKIE_SECURE=false
