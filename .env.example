# Used by docker-compose.yml. Copy to .env (git-ignored): cp .env.example .env

# LOCAL PLACEHOLDERS ONLY. Never reuse these anywhere real.
# Generate your own with: openssl rand -base64 48   (min 32 chars, the two must differ)
JWT_ACCESS_SECRET=local-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-only-refresh-secret-change-me-9876543210

# MongoDB. LOCAL PLACEHOLDERS ONLY.
# MONGO_INITDB_* only applies on an EMPTY volume: changing it later has no effect until you
# run `docker compose down -v` (this deletes the data).
# The API connects as the app user (readWrite on easygenerator-auth only), never as root.
# Both Mongo passwords end up inside MONGO_URI, so they must be URL-safe: no @ : / ? # or %.
# Generate them with: openssl rand -hex 24
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=local-only-root-password-change-me
MONGO_APP_USERNAME=easygenerator_app
MONGO_APP_PASSWORD=local-only-app-password-change-me

# Public (baked into the web bundle at build time). Never put secrets here.
VITE_APP_NAME=Secure Auth
