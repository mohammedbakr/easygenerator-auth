# Used by docker-compose.yml. Copy to .env (git-ignored): cp .env.example .env

# LOCAL PLACEHOLDERS ONLY. Never reuse these anywhere real.
# Generate your own with: openssl rand -base64 48   (min 32 chars, the two must differ)
JWT_ACCESS_SECRET=local-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-only-refresh-secret-change-me-9876543210

# Public (baked into the web bundle at build time). Never put secrets here.
VITE_APP_NAME=Secure Auth
